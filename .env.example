# ==============================================================================
# VoucherBox Environment Configuration
# ==============================================================================

# Private key of the deployer wallet (do NOT include 0x prefix)
# Required for running: npm run deploy:testnet or npm run deploy:mainnet
PRIVATE_KEY=your_private_key_here

# BOT Chain Network RPC URLs
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai

# Frontend Configuration
# Reown AppKit Project ID from https://cloud.reown.com/ (free, get in 10 seconds)
# A default public fallback project ID is provided in code for quick testing
VITE_REOWN_PROJECT_ID=b56e18d47c72ab683b10814fe9495694

# Deployed Contract Address (filled automatically after running deploy script or set manually)
VITE_CONTRACT_ADDRESS=

